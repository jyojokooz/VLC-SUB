# Copy to .env and fill in your keys — NEVER commit .env to git!

# Groq API keys (get free keys at console.groq.com — add as many as you want)
VSUB_GROQ_KEYS=gsk_key1,gsk_key2,gsk_key3

# OpenAI API keys (optional fallback)
VSUB_OPENAI_KEYS=sk-openai-key1

# Optional: require this token from the .Vsub client (set same value in app)
VSUB_SECRET=

# Per-IP rate limit (transcriptions per hour per user IP)
VSUB_IP_LIMIT_PER_HOUR=30

# Max audio upload size in MB
VSUB_MAX_FILE_MB=25
